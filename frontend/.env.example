# Backend API Base URL
# In local development: Leave blank to use Vite dev proxy (http://localhost:8000)
# In production (e.g. Vercel): https://seespeakai-2.onrender.com
VITE_API_URL=

# Backend WebSocket URL
# In local development: Leave blank to use localhost (ws://localhost:8000/ws/session)
# In production (e.g. Vercel): wss://seespeakai-2.onrender.com/ws/session
VITE_WS_URL=
