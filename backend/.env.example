# ==========================================
# seeSpeak AI Backend Configuration
# ==========================================

# Google Gemini API Key (Required for live multimodal AI and Gemini Live Real-Time Voice)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Voice Mode ('gemini' or 'mock')
VOICE_MODE=gemini

# Server Configuration
HOST=127.0.0.1
PORT=8000
